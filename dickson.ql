DROP TABLE IF EXISTS `opportunity_activities`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `opportunity_activities` (
  `id` int unsigned NOT NULL AUTO_INCREMENT,
  `opportunity_id` int unsigned NOT NULL,
  `activity_date` date DEFAULT NULL,
  `title` varchar(191) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `note` text COLLATE utf8mb4_unicode_ci,
  `created_at` datetime DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_activities_opp` (`opportunity_id`),
  CONSTRAINT `fk_activities_opp` FOREIGN KEY (`opportunity_id`) REFERENCES `opportunities` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=361 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `opportunity_activities`
--

LOCK TABLES `opportunity_activities` WRITE;
/*!40000 ALTER TABLE `opportunity_activities` DISABLE KEYS */;
